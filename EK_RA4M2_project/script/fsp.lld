/*
                  Linker File for Renesas FSP Bootloader
*/

/*
 * This project is the bootloader.
 * It resides in the first 64KB of flash (0x00000 - 0x0FFFF).
 * The main application will be flashed starting at 0x10000.
*/

FLASH_START = 0x00000000;
FLASH_LENGTH = 0x00010000; /* 64 KB */

/* Include the rest of the linker information */
INCLUDE memory_regions.lld
INCLUDE fsp_gen.lld